{
 "doctype": "DocType",
 "name": "Site Expense Entry",
 "module": "SBI Projects",
 "custom": 0,
 "engine": "InnoDB",
 "istable": 0,
 "editable_grid": 0,
 "actions": [],
 "links": [],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "project",
