{
 "doctype": "DocType",
 "name": "Site Resource",
 "module": "SBI Projects",
 "custom": 0,
 "engine": "InnoDB",
 "istable": 0,
 "editable_grid": 0,
 "actions": [],
 "links": [],
 "autoname": "field:resource_name",
 "naming_rule": "By fieldname",
 "sort_field": "modified",
 "sort_order": "DESC",
 "index_web_pages_for_search": 1,
 "allow_rename": 0,
 "fields": [
  {
   "fieldname": "resource_name",
   "fieldtype": "Data",
   "label": "Resource Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "category",
   "fieldtype": "Select",
   "label": "Category",
   "options": "\nLabour\nMaterial\nEquipment\nSubcontract\nOther",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "unit",
   "fieldtype": "Data",
   "label": "Unit",
   "in_list_view": 1
  },
  {
   "fieldname": "rate",
   "fieldtype": "Currency",
   "label": "Rate",
   "in_list_view": 1
  },
  {
   "fieldname": "sec_stock",
   "fieldtype": "Section Break",
   "label": "Stock Link (Material only)",
   "depends_on": "eval:doc.category=='Material'"
  },
  {
   "fieldname": "item",
   "fieldtype": "Link",
   "label": "Stock Item",
   "options": "Item",
   "description": "Link to the ERPNext Item for stock tracking, FIFO and procurement"
  },
  {
   "fieldname": "cb_s",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "min_stock",
   "fieldtype": "Float",
   "label": "Minimum Stock",
   "precision": "3",
   "description": "Reorder level at site; shortages below this appear in Material Status"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Projects Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "export": 1,
   "report": 1,
   "share": 1
  }
 ]
}