   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "category",
   "fieldtype": "Select",
   "label": "Category",
   "options": "\nEquipment\nSubcontract\nTransport\nOther",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "equipment_type",
   "fieldtype": "Select",
   "label": "Equipment Type",
   "options": "\nRental\nNew",
   "default": "Rental",
   "depends_on": "eval:doc.category=='Equipment'"
  },
  {
   "fieldname": "cb0",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "stage",
   "fieldtype": "Data",
   "label": "Stage"
  },
  {
   "fieldname": "party",
   "fieldtype": "Data",
   "label": "Supplier / SC Name"
  },
  {
