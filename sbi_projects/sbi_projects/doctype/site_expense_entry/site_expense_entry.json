   "fieldtype": "Select",
   "label": "Paid From",
   "options": "Site Cash\nOffice",
   "default": "Site Cash",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sec1",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Reason / Description",
   "reqd": 1
  },
  {
   "fieldname": "qty",
   "fieldtype": "Float",
   "label": "Qty",
   "precision": "3"
  },
  {
   "fieldname": "uom",
   "fieldtype": "Data",
   "label": "UOM"
  },
  {
   "fieldname": "cb1",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "rate",
   "fieldtype": "Currency",
   "label": "Rate"
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "entered_by",
   "fieldtype": "Link",
   "label": "Entered By",
   "options": "User",
   "read_only": 1
  }
 ],
