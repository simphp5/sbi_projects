  },
  {
   "fieldname": "last_alt_vch_id",
   "fieldtype": "Int",
   "label": "Vouchers Synced up to Alter ID",
   "read_only": 1
  },
  {
   "fieldname": "cancel_cursor",
   "fieldtype": "Datetime",
   "label": "Cancellations Checked Until",
   "read_only": 1
  },
  {
   "fieldname": "force_import_guids",
   "fieldtype": "Small Text",
   "label": "Import Anyway (Tally GUIDs)",
   "read_only": 1
  }
 ],
